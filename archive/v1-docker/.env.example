# LiteLLM Gateway
LITELLM_BASE_URL=https://llmproxy.atlan.dev
LITELLM_API_KEY=your-litellm-key-here

# Embedding model available on your LiteLLM instance
EMBEDDING_MODEL=text-embedding-3-small

# Postgres (used internally by docker-compose)
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory_secret
POSTGRES_DB=memory_store
DATABASE_URL=postgresql://memory:memory_secret@postgres:5432/memory_store
